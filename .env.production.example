NODE_ENV=production
PORT=3000
VOICE_MODE=sfu

# LiveKit SFU
LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=SET_IN_RAILWAY_SECRETS
LIVEKIT_API_SECRET=SET_IN_RAILWAY_SECRETS

# Production TURN / relay (if not supplied by your LiveKit deployment)
TURN_URL=turn:YOUR_TURN_HOST:3478,turns:YOUR_TURN_HOST:5349
TURN_USERNAME=SET_IN_RAILWAY_SECRETS
TURN_CREDENTIAL=SET_IN_RAILWAY_SECRETS

# Multi-instance production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# OTP delivery: choose ONE production provider.
# SMS via your Railway/cloud SMS service:
SMS_GATEWAY_MODE=http
SMS_GATEWAY_URL=https://YOUR-RAILWAY-SMS-GATEWAY/send
SMS_GATEWAY_TOKEN=SET_IN_RAILWAY_SECRETS
SMS_GATEWAY_TIMEOUT_MS=10000

# OR Meta WhatsApp Cloud API (use instead of the SMS settings above):
# SMS_GATEWAY_MODE=whatsapp
# WHATSAPP_CLOUD_API_TOKEN=SET_IN_RAILWAY_SECRETS
# WHATSAPP_PHONE_NUMBER_ID=SET_IN_RAILWAY_SECRETS
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_OTP_TEMPLATE_NAME=pingpong_otp
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_TIMEOUT_MS=10000

# Never enable OTP test mode in production.
OTP_TEST_MODE=false
# Leave OTP_TEST_WHATSAPP_TO unset in production.

# Production application infrastructure (required)
ADMIN_USERNAME=SET_IN_RAILWAY_SECRETS
ADMIN_PASSWORD=SET_IN_RAILWAY_SECRETS
METRICS_TOKEN=SET_IN_RAILWAY_SECRETS
CORS_ORIGINS=https://YOUR-PRODUCTION-DOMAIN
REDIS_ENABLED=true
CLUSTER_ENABLED=true
METRICS_PUBLIC=false

# Recharge is fail-closed until configured by an authorized admin.
# Never place admin credentials or payment gateway secrets in source control.
