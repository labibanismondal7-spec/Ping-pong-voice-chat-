# PingPong production environment
NODE_ENV=production
PORT=3000

# Voice: use SFU for production multi-user rooms.
# mesh is kept as a fallback/testing mode only.
VOICE_MODE=agora
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
# 8 seats can publish, while audience listeners can also subscribe.
LIVEKIT_MAX_PARTICIPANTS=64

# Agora RTC production room voice. Set VOICE_MODE=agora only after the
# Agora project is configured and the end-to-end production smoke test passes.
# AGORA_APP_CERTIFICATE is a secret: set it ONLY as a Railway/host
# environment variable. Never put a real value here or anywhere in
# source control. Leaving these unset keeps /api/agora/token returning
# a clean 503 with zero effect on any existing voice/call path.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600

# TURN is still recommended for direct 1:1 private calls and any mesh fallback.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:YOUR_TURN_HOST:3478,turns:YOUR_TURN_HOST:5349
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# Optional dynamic TURN credentials (preferred when your TURN provider supports it)
# TURN_SECRET=YOUR_TURN_SHARED_SECRET
# TURN_REALM=YOUR_TURN_REALM
# TURN_CREDENTIAL_TTL_SECONDS=21600

# Cloudflare TURN (Phase 7 — short-lived credential service). If set, this
# takes priority over the legacy static/dynamic TURN_* vars above (see
# turn-config.js's getStatus()). Leave empty/unset to keep using the
# legacy TURN_* vars, or STUN-only if neither is configured. The API
# token is a server-side-only secret — it must never reach the browser/app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Database / cluster (enable when deploying multiple Node instances)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# REDIS_URL=redis://:PASSWORD@HOST:6379
# CLUSTER_ENABLED=true

# CORS (comma-separated origins)
# CORS_ORIGINS=https://your-domain.example


# AI Customer Service (Room 101 text/room-assistant replies) — required for
# Robin/PingPong AI to actually generate text answers. Without a key here,
# customers get the safe fallback message ("cannot respond right now").
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
# Optional: set both OPENAI_API_KEY and AI_FALLBACK_PROVIDER=openai so that
# if Gemini fails (rate limit/outage), OpenAI is tried automatically before
# the customer sees any error.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-4o-mini
# AI_FALLBACK_PROVIDER=openai

# Vapi AI customer-support voice (Robin / Room 101)
# Public key is safe for browser/client-side use. Do NOT put a private Vapi API key here.
VAPI_PUBLIC_KEY=REPLACE_WITH_VAPI_PUBLIC_KEY
VAPI_ASSISTANT_ID=3ec88d92-7146-4531-a26d-b790edf51f70
VAPI_DEMO_URL=https://vapi.ai/?demo=true&shareKey=f3ac552d-b25f-4afc-98a0-b64eeab0fc16&assistantId=3ec88d92-7146-4531-a26d-b790edf51f70

# ---------------------------------------------------------------
# Mobile OTP delivery
# ---------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# TESTING ONLY — opens WhatsApp with OTP prefilled; user must tap Send.
OTP_TEST_MODE=true
OTP_TEST_WHATSAPP_TO=918101221193

# Keep "local" for Termux SIM testing. For Railway/cloud production use
# "http" for your SMS service OR "whatsapp" for Meta WhatsApp Cloud API.
SMS_GATEWAY_MODE=local
SMS_SENDER_NAME=PingPong

# WhatsApp Cloud API (production option; never commit real secrets)
# SMS_GATEWAY_MODE=whatsapp
# WHATSAPP_CLOUD_API_TOKEN=SET_IN_RAILWAY_SECRETS
# WHATSAPP_PHONE_NUMBER_ID=SET_IN_RAILWAY_SECRETS
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_OTP_TEMPLATE_NAME=pingpong_otp
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_TIMEOUT_MS=10000

# Production SMS gateway alternative
# SMS_GATEWAY_MODE=http
# SMS_GATEWAY_URL=https://YOUR-RAILWAY-SMS-GATEWAY.example.com/send
# SMS_GATEWAY_TOKEN=SET_IN_RAILWAY_SECRETS
# SMS_GATEWAY_TIMEOUT_MS=10000
